@{
    ViewData["Title"] = "Confirmation d'email envoyée";
}

<div class="flex min-h-screen items-center justify-center bg-gray-50 px-4 py-12 sm:px-6 lg:px-8">
    <div class="w-full max-w-md space-y-8 text-center">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-gray-900">Email envoyé</h1>
            <p class="mt-4 text-sm text-gray-600">
                Si un compte existe avec l'adresse email fournie, vous recevrez un lien de réinitialisation.
            </p>
            <p class="mt-4">
                <a asp-action="Login" class="text-sm font-semibold text-emerald-600 hover:text-emerald-500 transition-colors">
                    Retour à la connexion
                </a>
            </p>
        </div>
    </div>
</div>
