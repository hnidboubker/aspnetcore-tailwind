@page "/login"
@rendermode InteractiveWebAssembly
@using TailwindBlazor.Web.Client.Components.Account
@inject IdentityAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Connexion</PageTitle>

<div class="flex min-h-screen items-center justify-center bg-gray-50 px-4 py-12 sm:px-6 lg:px-8">
    <div class="w-full max-w-md space-y-8">
        <div class="text-center">
            <h1 class="text-3xl font-bold tracking-tight text-gray-900">Connexion</h1>
            <p class="mt-2 text-sm text-gray-600">
                Pas encore de compte ?
                <a href="/register" class="font-semibold text-emerald-600 hover:text-emerald-500 transition-colors">
                    Créer un compte
                </a>
            </p>
        </div>

        <EditForm Model="this" OnValidSubmit="HandleLogin" class="mt-8 space-y-6">
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="rounded-lg bg-red-50 p-4 text-sm text-red-700">@_errorMessage</div>
            }

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium leading-6 text-gray-900">Email</label>
                    <input @bind="_email" type="email" autocomplete="username"
                           class="mt-2 block w-full rounded-lg border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-emerald-600 sm:text-sm sm:leading-6" />
                </div>

                <div>
                    <label class="block text-sm font-medium leading-6 text-gray-900">Mot de passe</label>
                    <input @bind="_password" type="password" autocomplete="current-password"
                           class="mt-2 block w-full rounded-lg border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-emerald-600 sm:text-sm sm:leading-6" />
                </div>

                <div class="flex items-center">
                    <input @bind="_rememberMe" type="checkbox"
                           class="h-4 w-4 rounded border-gray-300 text-emerald-600 focus:ring-emerald-600" />
                    <label class="ml-2 block text-sm text-gray-900">Se souvenir de moi</label>
                </div>
            </div>

            <div>
                <button type="submit" disabled="@_isLoading"
                        class="flex w-full justify-center rounded-lg bg-emerald-600 px-3 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 transition-colors disabled:opacity-50">
                    @(_isLoading ? "Connexion en cours..." : "Se connecter")
                </button>
            </div>

            <div class="text-center">
                <a href="/forgot-password" class="text-sm font-semibold text-emerald-600 hover:text-emerald-500 transition-colors">
                    Mot de passe oublié ?
                </a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private bool _rememberMe;
    private bool _isLoading;
    private string? _errorMessage;

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;

        var success = await AuthStateProvider.Login(_email, _password, _rememberMe);

        if (success)
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            _errorMessage = "Email ou mot de passe invalide.";
        }

        _isLoading = false;
    }
}
