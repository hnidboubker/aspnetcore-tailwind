@page "/manage"
@rendermode InteractiveWebAssembly
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Mon profil</PageTitle>

<div class="min-h-screen bg-gray-50">
    <div class="mx-auto max-w-2xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="mb-8">
            <h1 class="text-2xl font-bold tracking-tight text-gray-900">Mon profil</h1>
            <p class="mt-2 text-sm text-gray-600">Gérez vos informations personnelles.</p>
        </div>

        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <div class="rounded-lg bg-emerald-50 p-4 text-sm text-emerald-700 mb-6">@_statusMessage</div>
        }

        <div class="rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5 p-6 space-y-6">
            <div>
                <label class="block text-sm font-medium leading-6 text-gray-900">Prénom</label>
                <input @bind="_firstName" type="text"
                       class="mt-2 block w-full rounded-lg border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-emerald-600 sm:text-sm sm:leading-6" />
            </div>

            <div>
                <label class="block text-sm font-medium leading-6 text-gray-900">Nom</label>
                <input @bind="_lastName" type="text"
                       class="mt-2 block w-full rounded-lg border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-emerald-600 sm:text-sm sm:leading-6" />
            </div>

            <div>
                <label class="block text-sm font-medium leading-6 text-gray-900">Email</label>
                <input @bind="_email" type="email" disabled
                       class="mt-2 block w-full rounded-lg border-0 px-3.5 py-2.5 text-gray-500 shadow-sm ring-1 ring-inset ring-gray-200 bg-gray-50 sm:text-sm sm:leading-6" />
            </div>
        </div>

        <div class="flex items-center justify-between mt-6">
            <a href="/manage/changepassword" class="text-sm font-semibold text-emerald-600 hover:text-emerald-500 transition-colors">
                Changer le mot de passe
            </a>

            <button @onclick="SaveProfile"
                    class="rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 transition-colors">
                Sauvegarder
            </button>
        </div>
    </div>
</div>

@code {
    private string _firstName = "";
    private string _lastName = "";
    private string _email = "";
    private string? _statusMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userInfo = await Http.GetFromJsonAsync<UserInfo>("account/user");
            if (userInfo != null)
            {
                _firstName = userInfo.FirstName ?? "";
                _lastName = userInfo.LastName ?? "";
                _email = userInfo.Email ?? "";
            }
        }
        catch { }
    }

    private async Task SaveProfile()
    {
        await Http.PostAsJsonAsync("account/profile", new { FirstName = _firstName, LastName = _lastName });
        _statusMessage = "Profil mis à jour avec succès.";
    }

    private class UserInfo
    {
        public string? FirstName { get; set; }
        public string? LastName { get; set; }
        public string? Email { get; set; }
    }
}
