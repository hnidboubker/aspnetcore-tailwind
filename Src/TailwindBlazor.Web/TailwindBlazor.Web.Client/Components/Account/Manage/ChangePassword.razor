@page "/manage/changepassword"
@rendermode InteractiveWebAssembly
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Changer le mot de passe</PageTitle>

<div class="min-h-screen bg-gray-50">
    <div class="mx-auto max-w-2xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="mb-8">
            <h1 class="text-2xl font-bold tracking-tight text-gray-900">Changer le mot de passe</h1>
            <p class="mt-2 text-sm text-gray-600">Assurez-vous que votre mot de passe est long et aléatoire.</p>
        </div>

        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <div class="rounded-lg bg-emerald-50 p-4 text-sm text-emerald-700 mb-6">@_statusMessage</div>
        }

        @if (_errors.Length > 0)
        {
            <div class="rounded-lg bg-red-50 p-4 text-sm text-red-700 mb-6">
                <ul class="list-disc list-inside">
                    @foreach (var error in _errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5 p-6 space-y-6">
            <div>
                <label class="block text-sm font-medium leading-6 text-gray-900">Mot de passe actuel</label>
                <input @bind="_oldPassword" type="password"
                       class="mt-2 block w-full rounded-lg border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-emerald-600 sm:text-sm sm:leading-6" />
            </div>

            <div>
                <label class="block text-sm font-medium leading-6 text-gray-900">Nouveau mot de passe</label>
                <input @bind="_newPassword" type="password"
                       class="mt-2 block w-full rounded-lg border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-emerald-600 sm:text-sm sm:leading-6" />
            </div>

            <div>
                <label class="block text-sm font-medium leading-6 text-gray-900">Confirmer le mot de passe</label>
                <input @bind="_confirmPassword" type="password"
                       class="mt-2 block w-full rounded-lg border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-emerald-600 sm:text-sm sm:leading-6" />
            </div>
        </div>

        <div class="flex items-center justify-between mt-6">
            <a href="/manage" class="text-sm font-semibold text-emerald-600 hover:text-emerald-500 transition-colors">
                Retour au profil
            </a>

            <button @onclick="HandleChangePassword"
                    class="rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 transition-colors">
                Mettre à jour
            </button>
        </div>
    </div>
</div>

@code {
    private string _oldPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private string? _statusMessage;
    private string[] _errors = Array.Empty<string>();

    private async Task HandleChangePassword()
    {
        if (_newPassword != _confirmPassword)
        {
            _errors = new[] { "Les mots de passe ne correspondent pas." };
            return;
        }

        var response = await Http.PostAsJsonAsync("account/changepassword", new
        {
            OldPassword = _oldPassword,
            NewPassword = _newPassword
        });

        var result = await response.Content.ReadFromJsonAsync<ChangePasswordResult>();

        if (result?.Success == true)
        {
            _statusMessage = "Mot de passe mis à jour avec succès.";
            _errors = Array.Empty<string>();
        }
        else
        {
            _errors = result?.Errors ?? new[] { "Erreur lors du changement de mot de passe." };
        }
    }

    private class ChangePasswordResult
    {
        public bool Success { get; set; }
        public string[]? Errors { get; set; }
    }
}
