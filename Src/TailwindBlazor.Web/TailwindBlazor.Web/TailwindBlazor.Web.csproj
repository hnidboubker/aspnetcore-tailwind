<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

	  <!-- Optional: disable native app host generation. The application will run using "dotnet MyApp.dll". -->
	  <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TailwindBlazor.Web.Client\TailwindBlazor.Web.Client.csproj" />
    <ProjectReference Include="..\..\TailwindIdentity.Core\TailwindIdentity.Core.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.29" />
  </ItemGroup>

	<ItemGroup>
		<UpToDateCheckBuilt Include="wwwroot/css/app.css" Set="Css" />
		<UpToDateCheckBuilt Include="postcss.config.js" Set="Css" />
	</ItemGroup>


	<Target Name="Tailwind" BeforeTargets="Build">
		<Exec Command="npm run css:build" />
	</Target>


</Project>
