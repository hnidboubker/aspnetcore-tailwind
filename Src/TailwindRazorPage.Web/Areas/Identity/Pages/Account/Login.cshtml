@page
@model TailwindIdentity.Core.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Connexion";
}

<div class="flex min-h-screen items-center justify-center bg-gray-50 px-4 py-12 sm:px-6 lg:px-8">
    <div class="w-full max-w-md space-y-8">
        <div class="text-center">
            <h1 class="text-3xl font-bold tracking-tight text-gray-900">Connexion</h1>
            <p class="mt-2 text-sm text-gray-600">
                Pas encore de compte ?
                <a asp-page="Register" class="font-semibold text-emerald-600 hover:text-emerald-500 transition-colors">
                    Créer un compte
                </a>
            </p>
        </div>

        <form method="post" class="mt-8 space-y-6">
            <div asp-validation-summary="ModelOnly" class="rounded-lg bg-red-50 p-4 text-sm text-red-700" role="alert"></div>

            <div class="space-y-4">
                <div>
                    <label asp-for="Input.Email" class="block text-sm font-medium leading-6 text-gray-900">Email</label>
                    <input asp-for="Input.Email" autocomplete="username"
                           class="mt-2 block w-full rounded-lg border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-emerald-600 sm:text-sm sm:leading-6" />
                    <span asp-validation-for="Input.Email" class="mt-1 text-sm text-red-600"></span>
                </div>

                <div>
                    <label asp-for="Input.Password" class="block text-sm font-medium leading-6 text-gray-900">Mot de passe</label>
                    <input asp-for="Input.Password" autocomplete="current-password"
                           class="mt-2 block w-full rounded-lg border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-emerald-600 sm:text-sm sm:leading-6" />
                    <span asp-validation-for="Input.Password" class="mt-1 text-sm text-red-600"></span>
                </div>

                <div class="flex items-center justify-between">
                    <div class="flex items-center">
                        <input asp-for="Input.RememberMe" type="checkbox"
                               class="h-4 w-4 rounded border-gray-300 text-emerald-600 focus:ring-emerald-600" />
                        <label asp-for="Input.RememberMe" class="ml-2 block text-sm text-gray-900">
                            Se souvenir de moi
                        </label>
                    </div>

                    <div class="text-sm">
                        <a asp-page="ForgotPassword" class="font-semibold text-emerald-600 hover:text-emerald-500 transition-colors">
                            Mot de passe oublié ?
                        </a>
                    </div>
                </div>
            </div>

            <div>
                <button type="submit"
                        class="flex w-full justify-center rounded-lg bg-emerald-600 px-3 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 transition-colors">
                    Se connecter
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
