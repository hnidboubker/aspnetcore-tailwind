@page
@model SignUpPageModel
@{
    ViewData["Title"] = "Inscription";
}

<div class="mx-auto flex min-h-screen max-w-7xl flex-col justify-center px-6 py-12">

    <div class="mx-auto w-full max-w-md">
        <h1 class="mb-2 text-2xl font-bold text-gray-900">Créer un compte</h1>
        <p class="mb-8 text-sm text-gray-600">
            Inscrivez-vous pour commencer.
        </p>

        <div class="rounded-xl bg-white p-8 shadow-sm ring-1 ring-gray-900/5">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-600"></div>

                <div class="mb-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                        <label asp-for="Input.FirstName" class="mb-1 block text-sm font-medium text-gray-700"></label>
                        <input asp-for="Input.FirstName" autocomplete="given-name"
                               class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" />
                        <span asp-validation-for="Input.FirstName" class="text-xs text-red-600"></span>
                    </div>
                    <div>
                        <label asp-for="Input.LastName" class="mb-1 block text-sm font-medium text-gray-700"></label>
                        <input asp-for="Input.LastName" autocomplete="family-name"
                               class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" />
                        <span asp-validation-for="Input.LastName" class="text-xs text-red-600"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.Email" class="mb-1 block text-sm font-medium text-gray-700"></label>
                    <input asp-for="Input.Email" autocomplete="email"
                           class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" />
                    <span asp-validation-for="Input.Email" class="text-xs text-red-600"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.Password" class="mb-1 block text-sm font-medium text-gray-700"></label>
                    <input asp-for="Input.Password" autocomplete="new-password"
                           class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" />
                    <span asp-validation-for="Input.Password" class="text-xs text-red-600"></span>
                </div>

                <div class="mb-6">
                    <label asp-for="Input.ConfirmPassword" class="mb-1 block text-sm font-medium text-gray-700"></label>
                    <input asp-for="Input.ConfirmPassword" autocomplete="new-password"
                           class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-xs text-red-600"></span>
                </div>

                <button type="submit"
                        class="w-full rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600">
                    S'inscrire
                </button>
            </form>
        </div>

        <p class="mt-6 text-center text-sm text-gray-600">
            Déjà un compte ?
            <a asp-page="/Account/SignInPage" class="font-medium text-emerald-600 hover:text-emerald-500">Connexion</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
