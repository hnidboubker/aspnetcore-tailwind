<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TailwindRazorPage.Web</title>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body class="bg-gray-50 text-gray-900">

    <div class="flex min-h-screen flex-col">

        <!-- Main -->
        <main class="flex flex-1 items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="border-t border-gray-200 bg-white py-6">
            <div class="mx-auto max-w-7xl px-4 text-center text-sm text-gray-500 sm:px-6 lg:px-8">
                &copy; @DateTime.Now.Year - TailwindRazorPage.Web
            </div>
        </footer>
    </div>

    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        lucide.createIcons();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
